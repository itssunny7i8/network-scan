# ============================================================
# Frontend Environment Variables
# Copy this to .env.local and fill in your actual values.
# ============================================================

# The URL of your deployed Express backend (Render service URL)
# Leave empty in development — Vite's proxy in vite.config.ts handles it.
# In production: set this to your Render service URL
# Example: VITE_API_URL=https://recon-lab-api.onrender.com
VITE_API_URL=
