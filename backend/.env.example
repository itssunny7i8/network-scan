# ============================================================
# Backend Environment Variables (.env)
# Copy this to .env and fill in your actual values.
# ============================================================

# Port to run the Express server on (Render sets this automatically)
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
# In production: set to your Vercel deployment URL(s)
# Example: CORS_ORIGIN=https://recon-lab.vercel.app,https://recon-lab-git-main-yourname.vercel.app
CORS_ORIGIN=http://localhost:3000

# Node environment
NODE_ENV=development
