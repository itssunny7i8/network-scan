# =========================================================================
# Nmap Network Scanner Simulator - Environment Variables Configuration
# =========================================================================
# Copy this file to a new file named '.env' in your backend/ or root folder 
# if you wish to override default configurations.

# The port where the backend Express API server will listen
PORT=5000

# The environment mode (development or production)
NODE_ENV=development

# Optional: The base API URL for the frontend if hosted on different servers
# In local development, Vite uses the proxy configured in vite.config.ts.
# For production environments, point this to your backend domain.
VITE_API_URL=http://localhost:5000
